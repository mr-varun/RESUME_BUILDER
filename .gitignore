# Dependencies (regenerate with `composer install`)
/vendor/

# Local secrets / environment-specific config
/config/config.php
.env
.env.*

# Install state marker (generated by install.php)
/.installed

# User-uploaded content (private data)
/uploads/photos/*
!/uploads/photos/.gitkeep

# Logs
*.log

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
